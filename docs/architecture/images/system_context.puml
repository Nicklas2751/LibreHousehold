@startuml
left to right direction
skinparam componentFontColor automatic
skinparam component {
  backgroundColor<<system>> CornflowerBlue
}
skinparam nodesep 20

component "LibreHousehold" <<system>> as librehousehold {
        portOut "SMTP" as smtp
        portOut "OAuth2/OIDC" as oauth
}

actor "User" as user
actor "Administrator" as admin

node "E-Mail Server" as mail
node "Social Login Provider" <<optional>> as ext_auth

user -l-> librehousehold
user --> ext_auth
admin -r-> librehousehold
smtp --> mail
oauth --> ext_auth

admin -[hidden]-> user

legend bottom
  <#GhostWhite,#GhostWhite>|        |= __Legend__ |
  |<#CornflowerBlue>  | System|
  | | External systems and actors|
end legend

@enduml